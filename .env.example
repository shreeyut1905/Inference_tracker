OPENROUTER_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free
LLM_ENABLED=true
LLM_FAIL_OPEN=false
LLM_MAX_PAPERS=50
